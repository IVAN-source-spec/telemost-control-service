CONTROL_SERVICE_HOST=0.0.0.0
CONTROL_SERVICE_PORT=8010
CONTROL_SERVICE_REQUIRE_API_TOKEN=0
CONTROL_SERVICE_API_TOKEN=change-me

# Path to JSON file with configured bot nodes.
BOT_NODES_CONFIG=config/nodes.json

# Alternative inline node config:
# BOT_NODES_JSON=[{"id":"telemost-vm-1","name":"Main VM","base_url":"http://192.168.100.142:8000","token":""}]

# Calendar monitor.
CALENDAR_MONITOR_ENABLED=0
CALENDAR_PROVIDER=caldav

# CalDAV mode.
CALENDAR_CALDAV_URL=https://caldav.yandex.ru/
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
CALENDAR_NAME=

# ICS mode.
CALENDAR_ICS_URL=
# Or JSON list:
# CALENDAR_ICS_URLS=["https://calendar.yandex.ru/export/....ics"]
CALENDAR_POLL_INTERVAL_SECONDS=60
CALENDAR_JOIN_BEFORE_MINUTES=2
CALENDAR_JOIN_AFTER_START_MINUTES=30
CALENDAR_TIMEZONE=Europe/Astrakhan
CALENDAR_STATE_FILE=data/calendar_seen.json
