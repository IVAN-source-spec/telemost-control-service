CONTROL_SERVICE_HOST=0.0.0.0
CONTROL_SERVICE_PORT=8010
CONTROL_SERVICE_REQUIRE_API_TOKEN=0
CONTROL_SERVICE_API_TOKEN=change-me

# Path to JSON file with configured bot nodes.
BOT_NODES_CONFIG=config/nodes.json

# Alternative inline node config:
# BOT_NODES_JSON=[{"id":"telemost-vm-1","name":"Main VM","base_url":"http://192.168.100.142:8000","token":""}]

# Calendar monitor.
CALENDAR_MONITOR_ENABLED=0
CALENDAR_PROVIDER=caldav

# CalDAV mode.
CALENDAR_CALDAV_URL=https://caldav.yandex.ru/
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
CALENDAR_NAME=

# ICS mode.
CALENDAR_ICS_URL=
# Or JSON list:
# CALENDAR_ICS_URLS=["https://calendar.yandex.ru/export/....ics"]
CALENDAR_POLL_INTERVAL_SECONDS=60
CALENDAR_JOIN_BEFORE_MINUTES=2
CALENDAR_JOIN_AFTER_START_MINUTES=30
CALENDAR_TIMEZONE=Europe/Astrakhan
CALENDAR_STATE_FILE=data/calendar_seen.json

# Meeting analytics. Rows are finalized only from factual bot task results;
# the planned calendar end never triggers completion or duration calculation.
APP_TIMEZONE=Europe/Astrakhan
DATABASE_URL=sqlite:////app/data/meeting_analytics.sqlite3
ANALYTICS_POLL_INTERVAL_SECONDS=30

# Read-only analytics scan of meeting artifacts on Yandex Disk.
YANDEX_DISK_TOKEN=
YANDEX_DISK_BASE_PATH=/Материалы встреч/Telemost Bot
YANDEX_DISK_ANALYTICS_INTERVAL_SECONDS=3600
YANDEX_DISK_DAILY_AUDIT_DAYS=7
SESSION_VALIDATOR_URL=http://127.0.0.1:8050
ASSIGNMENT_SERVICE_URL=http://127.0.0.1:8040
ASSIGNMENT_SERVICE_API_TOKEN=replace-with-the-assignment-service-token

# Browser access: Yandex OAuth plus the local registered-user allowlist.
# Enable only after telebot.razum.tools points to this service over HTTPS.
AUTH_ENABLED=0
YANDEX_AUTH_CLIENT_ID=
YANDEX_AUTH_CLIENT_SECRET=
YANDEX_AUTH_REDIRECT_URI=https://telebot.razum.tools/auth/callback
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_STATE_TTL_SECONDS=600
AUTH_COOKIE_SECURE=1
AUTH_DATABASE_URL=sqlite:////app/data/control_auth.sqlite3
AUTH_BOOTSTRAP_EMAILS=
AUTH_BOOTSTRAP_ADMIN_EMAILS=
